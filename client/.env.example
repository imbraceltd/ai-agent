# Client (Vite) environment variables — all must be prefixed with VITE_

# Base URL of the backend API the client calls directly
VITE_API_BASE_URL=

# Proxy targets used by the Vite dev server (see vite.config.ts)
VITE_APP_GATEWAY_URL=
VITE_APP_API_URL=

# Web app base URL used to build CRM record links
VITE_WEB_APP_URL=

# Set to "true" for on-premise deployments
VITE_APP_ON_PREMISE=
